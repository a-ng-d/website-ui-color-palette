# Embed the reference palette from a local web app (web-ui-color-palette, `npm run dev`).
# PUBLIC_DEMO_PALETTE_URL=http://app.ui-color-palette.com/palettes/f47fc3e0ad5

# Checkout of the Pricing page: a Netlify function (netlify/functions/checkout.mjs)
# creates the Polar checkout. Set these in Netlify (or a local .env with `netlify dev`).
# POLAR_ACCESS_TOKEN=polar_oat_...
# POLAR_SERVER=production   # or sandbox
# POLAR_SUCCESS_URL=https://app.ui-color-palette.com
