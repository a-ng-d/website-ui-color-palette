---
import '@/styles/global.css'

import Seo, { type Props as SeoProps } from '@/components/seo/Seo.astro'
import Header from '@/components/layout/Header.astro'
import Footer from '@/components/layout/Footer.astro'
import { site } from '@/config/site'

export type Props = SeoProps
---

<!doctype html>
<html
  lang={site.locale}
  data-theme="yelbolt"
  data-mode="yelbolt-uicp-light"
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <!-- Apply the saved (or system) colour mode before first paint. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('uicp-theme')
        const dark = saved
          ? saved === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.dataset.mode = dark
          ? 'yelbolt-uicp-dark'
          : 'yelbolt-uicp-light'
      } catch {}
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion')
        // Safety net: if the reveal script never runs, show everything.
        setTimeout(() => {
          if (!window.__revealReady)
            document.documentElement.classList.remove('motion')
        }, 3000)
      }
    </script>
    <link
      rel="icon"
      type="image/png"
      href="/favicon.png"
    />
    <link
      rel="sitemap"
      href="/sitemap-index.xml"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <Seo {...Astro.props} />
  </head>
  <body>
    <a
      class="skip-link"
      href="#main"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/reveal'
      import '@/scripts/consent'
    </script>
  </body>
</html>
