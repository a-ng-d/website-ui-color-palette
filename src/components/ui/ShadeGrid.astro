---
/**
 * The “Slots” motif from Figma: a frame of rounded shade tiles with gradient
 * lines showing through the gaps, and content tiles placed inside the frame.
 *
 * Only the outer ring of tiles is drawn; each named slot fills an inner area.
 */
import type { ImageMetadata } from 'astro'

interface Area {
  name: string
  colStart: number
  colSpan: number
  rowStart: number
  rowSpan: number
}

interface Props {
  cols: number
  rows: number
  graphs: ImageMetadata
  areas: Area[]
  class?: string
}

const { cols, rows, graphs, areas, class: className } = Astro.props

const rendered = await Promise.all(
  areas.map(async (area) => ({
    ...area,
    html: Astro.slots.has(area.name) ? await Astro.slots.render(area.name) : '',
  }))
)

const ring: { col: number; row: number }[] = []
for (let row = 1; row <= rows; row++) {
  for (let col = 1; col <= cols; col++) {
    if (row === 1 || row === rows || col === 1 || col === cols)
      ring.push({ col, row })
  }
}
---

<div
  class:list={['shade-grid', className]}
  style={`--cols:${cols};--rows:${rows}`}
>
  <img
    class="shade-grid__graphs"
    src={graphs.src}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
  <div class="shade-grid__tiles">
    {ring.map(({ col, row }) => (
      <span
        class="shade-grid__tile"
        aria-hidden="true"
        style={`grid-area:${row}/${col}`}
      />
    ))}
    {rendered.map((area) => (
      <div
        class={`shade-grid__area shade-grid__area--${area.name}`}
        style={`grid-area:${area.rowStart}/${area.colStart}/span ${area.rowSpan}/span ${area.colSpan}`}
        set:html={area.html}
      />
    ))}
  </div>
</div>

<style>
  .shade-grid {
    position: relative;
    border: var(--stroke-width-thin) solid var(--site-border-soft);
    border-radius: var(--site-radius-card);
    background-color: var(--site-surface-muted);
    overflow: clip;
  }

  .shade-grid__graphs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .shade-grid__tiles {
    display: grid;
    position: relative;
    grid-template-rows: repeat(
      var(--rows),
      minmax(var(--shade-row-min, 48px), auto)
    );
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-gap-050);
    padding: var(--space-gap-050);
    height: 100%;
  }

  .shade-grid__tile,
  .shade-grid__area {
    border-radius: var(--site-radius-inner);
    background-color: var(--site-surface);
  }

  .shade-grid__area {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: clip;
  }

  @media (max-width: 799.98px) {
    /* Side columns get too thin: keep only the top and bottom rows of tiles. */
    .shade-grid__tiles {
      grid-template-columns: minmax(0, 1fr);
    }

    .shade-grid__tile {
      display: none;
    }

    .shade-grid__area {
      grid-column: 1 !important;
    }

    .shade-grid__tiles::before,
    .shade-grid__tiles::after {
      border-radius: var(--site-radius-inner);
      background-color: var(--site-surface);
      height: var(--shade-row-min, 48px);
      content: '';
    }

    .shade-grid__tiles::before {
      grid-row: 1;
    }

    .shade-grid__tiles::after {
      grid-row: var(--rows);
    }
  }
</style>
