---
/**
 * Pill tabs as a native radio group, no JS. Mark panels with `data-tab="<item id>"`:
 * CSS (`:has(:checked)`) hides those of the other tabs, all stay visible without `:has()`.
 * Label hover/focus states are mirrored in styles/unoff-links.css. Wrapper is `display: contents`.
 *
 * A radio group is a single tab stop (arrows switch). With JS, each label
 * becomes a focusable toggle button so every tab, active or not, is reached
 * with Tab; the radios stay the source of truth for the CSS.
 */
interface Item {
  id: string
  label: string
}

interface Props {
  /** Unique per page: ids and radio group name. */
  name: string
  /** Accessible name of the group (not displayed). */
  label: string
  items: Item[]
  /** Tab selected on load (defaults to the first one). */
  active?: string
}

const { name, label, items, active = items[0]?.id } = Astro.props

const css = items
  .map(
    (item) =>
      `[data-tabs="${name}"]:has(#${name}-${item.id}:checked) [data-tab]:not([data-tab="${item.id}"]){display:none !important}`
  )
  .join('')
---

<div
  class="tabs"
  data-tabs={name}
>
  <fieldset class="tabs__list">
    <legend class="visually-hidden">{label}</legend>
    {items.map((item) => (
      <>
        <input
          class="visually-hidden"
          type="radio"
          name={name}
          id={`${name}-${item.id}`}
          value={item.id}
          checked={item.id === active}
        />
        <label
          class="text-button text-button--tertiary text-button--large"
          for={`${name}-${item.id}`}
        >
          <span class="text-button__label">{item.label}</span>
        </label>
      </>
    ))}
  </fieldset>
  <slot />
</div>
<style
  is:inline
  set:html={css}
></style>

<script>
  for (const group of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const pairs = [
      ...group.querySelectorAll<HTMLInputElement>('.tabs__list input'),
    ].map((input) => ({
      input,
      label: input.nextElementSibling as HTMLLabelElement,
    }))

    const sync = () => {
      for (const { input, label } of pairs)
        label.setAttribute('aria-pressed', String(input.checked))
    }

    for (const { input, label } of pairs) {
      // The label takes over: hide the radio from Tab and assistive tech.
      input.tabIndex = -1
      input.setAttribute('aria-hidden', 'true')
      label.tabIndex = 0
      label.setAttribute('role', 'button')
      label.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return
        e.preventDefault()
        input.click()
      })
      input.addEventListener('change', sync)
    }
    sync()
  }
</script>

<style>
  .tabs {
    display: contents;
  }

  .tabs__list {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    justify-content: center;
    align-self: center;
    gap: var(--space-gap-100);
    margin: 0;
    border: var(--stroke-width-thin) solid var(--site-border-strong);
    border-radius: var(--site-radius-pill);
    padding: var(--space-inset-200);
    min-inline-size: 0;
  }

  .tabs__list label {
    position: relative;
    justify-content: center;
    border: var(--stroke-width-thin) solid transparent;
    border-radius: var(--site-radius-pill);
    padding: var(--space-inset-100) var(--space-inset-400);
    min-height: 48px;
    white-space: nowrap;
  }

  .tabs__list input:checked + label {
    border-color: var(--site-border-soft);
    background-color: var(--site-surface-muted);
  }

  .tabs__list input:checked + label::after {
    position: absolute;
    bottom: 3px;
    left: 50%;
    translate: -50% 0;
    border-radius: 4px;
    background-color: var(--site-ink);
    width: 16px;
    height: 4px;
    content: '';
  }

  .tabs__list input:focus-visible + label {
    outline: var(--site-focus-outline);
    outline-offset: var(--site-focus-offset);
    box-shadow: var(--site-focus-halo);
  }

  @media (max-width: 479.98px) {
    .tabs__list {
      border-radius: var(--site-radius-card);
    }
  }
</style>
