---
interface Props {
  id: string
  title: string
  intro?: string
  ordered?: boolean
  cardMinHeight?: string
}

const { id, title, intro, ordered = false, cardMinHeight } = Astro.props
const titleId = `${id}-title`
const Cards = ordered ? 'ol' : 'div'
---

<section
  id={id}
  class="section stack"
  aria-labelledby={titleId}
  style={cardMinHeight ? `--stack-card-min-height:${cardMinHeight}` : undefined}
>
  <div class="stack__layout">
    <div class="stack__intro">
      <div class="stack__intro-content">
        <h2
          class="t-section-title"
          id={titleId}
        >
          {title}
        </h2>
        {intro && <p class="t-accent">{intro}</p>}
        <slot name="intro" />
      </div>
    </div>

    <Cards class="stack__cards">
      <slot />
    </Cards>
  </div>
</section>

<style>
  .stack__layout {
    display: grid;
    grid-template-columns: minmax(0, 600fr) minmax(0, 656fr);
    gap: var(--space-gap-200);
  }

  .stack__intro {
    display: flex;
    flex-direction: column;
    align-self: stretch; /* full height, so the reveal covers a real card */
    border: var(--stroke-width-thin) solid var(--site-border-soft);
    border-radius: var(--site-radius-card);
    background-color: var(--site-surface);
  }

  .stack__intro-content {
    display: flex;
    position: sticky;
    top: var(--layout-header-height);
    flex-direction: column;
    gap: var(--space-gap-400);
    padding: var(--space-inset-800);
  }

  /* Every stacked card has the height of the tallest: a card always covers
     the one beneath, which never shows under it. */
  .stack__cards {
    display: grid;
    grid-auto-rows: 1fr;
    gap: var(--layout-section-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack__cards > :global(*) {
    position: sticky;
    top: calc(var(--layout-header-height) + var(--space-inset-400));
    min-height: var(--stack-card-min-height, 540px);
  }

  @media (max-width: 1023.98px) {
    .stack__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .stack__intro-content {
      position: static;
    }

    .stack__cards {
      grid-auto-rows: auto;
      gap: var(--space-gap-200);
    }

    .stack__cards > :global(*) {
      position: static;
      min-height: 0;
    }
  }
</style>
