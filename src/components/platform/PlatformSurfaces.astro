---
/** Title card and live plugin embed on top, one card per editor below; the `media` slot replaces the embed. */
import IconTile from '@/components/ui/IconTile.astro'
import type { PlatformPage } from '@/data/platform-pages'

interface Props {
  surfaces: PlatformPage['surfaces']
}

const { surfaces } = Astro.props
---

<section
  class="section surfaces"
  aria-labelledby="surfaces-title"
>
  <div class="surfaces__grid">
    <div class="surfaces__intro">
      <h2
        class="t-section-title"
        id="surfaces-title"
      >
        {surfaces.title}
      </h2>
      <p class="t-accent">{surfaces.intro}</p>
    </div>

    {surfaces.cards.map((card) => (
      <article
        class="surfaces__card surface-card"
        style={card.span ? `--span:${card.span}` : undefined}
      >
        <IconTile icon={card.icon} />
        <h3 class="t-paragraph-primary-title">{card.title}</h3>
        <p class="t-accent">{card.text}</p>
      </article>
    ))}

    <div class="surfaces__embed">
      {surfaces.embed ? (
        <>
          <iframe
            class="surfaces__frame"
            data-embed-frame
            src={surfaces.embed.src}
            title={surfaces.embed.title}
            loading="lazy"
            allow="clipboard-write"
            referrerpolicy="strict-origin-when-cross-origin"
          />
          <a
            class="surfaces__fallback"
            href={surfaces.embed.src}
            target="_blank"
            rel="noopener"
          >
            Open the plugin preview in a new tab
          </a>
        </>
      ) : (
        <slot name="media" />
      )}
    </div>
  </div>
</section>

<script>
  // The embed URL carries mode=dark (also the no-JS default). Follow the site's
  // light / dark mode instead, including when the visitor switches it: the
  // plugin reads `mode` once at load, so the frame is reloaded with the new one.
  const frames = document.querySelectorAll<HTMLIFrameElement>(
    'iframe[data-embed-frame]'
  )
  const root = document.documentElement
  const modeOf = () =>
    root.dataset.mode === 'yelbolt-uicp-dark' ? 'dark' : 'light'

  const sync = () => {
    const mode = modeOf()
    for (const frame of frames) {
      const url = new URL(frame.src)
      if (url.searchParams.get('mode') === mode) continue
      url.searchParams.set('mode', mode)
      frame.src = url.href
    }
  }

  if (frames.length) {
    sync()
    new MutationObserver(sync).observe(root, {
      attributes: true,
      attributeFilter: ['data-mode'],
    })
  }
</script>

<style>
  .surfaces__grid {
    display: grid;
    grid-template-rows: repeat(3, minmax(416px, auto));
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-gap-200);
  }

  .surfaces__intro {
    display: flex;
    grid-row: 1 / span 2;
    grid-column: 1;
    flex-direction: column;
    gap: var(--space-gap-400);
    transform: rotate(1deg);
    border: var(--stroke-width-thin) solid var(--site-border-soft);
    border-radius: var(--site-radius-card);
    background-color: var(--site-surface);
    padding: var(--space-inset-800);
  }

  .surfaces__card {
    display: flex;
    grid-row: 3;
    grid-column: span var(--span, 1);
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-gap-400);
    padding: var(--space-inset-800);
  }

  .surfaces__embed {
    display: flex;
    grid-row: 1 / span 2;
    grid-column: 2 / span 2;
    border-radius: var(--site-radius-card);
    background-color: var(
      --site-surface-muted
    ); /* no white flash while loading */
    overflow: clip;
  }

  .surfaces__frame {
    flex: 1 1 auto;
    border: 0;
    width: 100%;
    min-height: 640px;
  }

  /* Visible to keyboard users, for whom the plugin is easier in its own tab. */
  .surfaces__fallback {
    position: absolute;
    clip-path: inset(50%);
    width: 1px;
    height: 1px;
    overflow: hidden;
    white-space: nowrap;
  }

  .surfaces__fallback:focus {
    position: static;
    clip-path: none;
    margin: var(--space-inset-200);
    width: auto;
    height: auto;
  }

  @media (max-width: 1023.98px) {
    .surfaces__grid {
      grid-template-rows: none;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(400px, auto);
    }

    .surfaces__intro,
    .surfaces__card,
    .surfaces__embed {
      grid-row: auto;
      grid-column: auto;
    }

    .surfaces__card {
      grid-column: span min(var(--span, 1), 2);
    }

    .surfaces__embed {
      grid-column: 1 / -1;
    }

    .surfaces__frame {
      min-height: 800px;
    }
  }

  @media (max-width: 639.98px) {
    .surfaces__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
    }

    .surfaces__intro {
      transform: none;
    }

    .surfaces__intro,
    .surfaces__card {
      padding: var(--space-inset-600);
    }

    .surfaces__card {
      grid-column: auto;
      min-height: 320px;
    }

    .surfaces__frame {
      min-height: 640px;
    }
  }
</style>
