---
import StackSection from '@/components/ui/StackSection.astro'
import type { PlatformSetup } from '@/data/platform-pages'

interface Props {
  setup: PlatformSetup
  docs: string
}

const { setup, docs } = Astro.props
---

<StackSection
  id="setup"
  title={setup.title}
  intro={setup.intro}
  ordered
  cardMinHeight="360px"
>
  <p
    class="setup__docs t-accent"
    slot="intro"
  >
    <a href={docs}>Read the full setup guide in the docs</a>
  </p>

  {setup.steps.map((step, index) => (
    <li class="setup__step surface-card">
      <span
        class="setup__index t-main-title"
        aria-hidden="true"
      >
        {String(index + 1).padStart(2, '0')}
      </span>
      <div class="setup__body">
        <h3 class="t-paragraph-secondary-title">{step.title}</h3>
        <p class="t-accent">{step.text}</p>
        {step.code && <code class="code-snippet">{step.code}</code>}
      </div>
    </li>
  ))}
</StackSection>

<style>
  .setup__docs a {
    text-decoration: underline;
  }

  .setup__step {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-gap-800);
    padding: var(--space-inset-800);
  }

  .setup__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-gap-400);
    min-width: 0;
  }
</style>
