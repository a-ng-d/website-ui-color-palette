---
import wave from '@/assets/decor/graphs-pricing.svg'
import ShadeGrid from '@/components/ui/ShadeGrid.astro'
---

<section
  class="pricing-hero"
  aria-labelledby="pricing-title"
>
  <ShadeGrid
    class="pricing-hero__grid"
    wave={{ src: wave, inset: '0 -2.58% -11.05% -2.58%' }}
    cols={16}
    rows={2}
    areas={[
      { name: 'hero', colStart: 3, colSpan: 12, rowStart: 1, rowSpan: 2 },
    ]}
  >
    <div
      class="pricing-hero__content"
      slot="hero"
    >
      <h1
        class="t-main-title"
        id="pricing-title"
      >
        UI Color Palette pricing
      </h1>
      <p class="t-tagline">
        Start free on /basic, go unlimited with /pro, or scale with /ultimate.
        Solo designer or team, we've got you covered.
      </p>
    </div>
  </ShadeGrid>
</section>

<style>
  .pricing-hero {
    padding: var(--space-inset-200) var(--layout-gutter) 0;
  }

  .pricing-hero :global(.pricing-hero__grid) {
    --shade-row-min: 148px;
  }

  .pricing-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-gap-400);
    padding: var(--space-inset-800);
    width: 100%;
    max-width: calc(var(--layout-content-max) + 2 * var(--space-inset-800));
    text-align: center;
  }
</style>
