---
import type { LinkCard } from '@/data/blocks'

interface Props {
  title: string
  intro: string
  items: LinkCard[]
}

const { title, intro, items } = Astro.props
const id = (href: string) =>
  `in-depth-card-${href.split('/').filter(Boolean).pop()}`
---

<section
  class="section in-depth"
  aria-labelledby="in-depth-title"
>
  <div class="in-depth__intro surface-card">
    <h2
      class="t-section-title"
      id="in-depth-title"
    >
      {title}
    </h2>
    <p class="t-accent">{intro}</p>
  </div>
  <ul class="in-depth__grid">
    {items.map((item) => (
      <li class="in-depth__item">
        <a
          class="in-depth__card card"
          href={item.href}
          aria-labelledby={id(item.href)}
        >
          <h3
            class="t-paragraph-secondary-title"
            id={id(item.href)}
          >
            {item.title}
          </h3>
          <p class="t-accent">{item.text}</p>
          <span
            class="in-depth__more text-button text-button--secondary text-button--large"
            aria-hidden="true"
          >
            <span class="text-button__label">{item.label}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .in-depth {
    display: flex;
    flex-direction: column;
    gap: var(--space-gap-200);
  }

  .in-depth__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-gap-400);
    border-color: var(--site-border-soft);
    background-color: var(--site-surface);
    padding: var(--space-inset-800);
  }

  .in-depth__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-gap-200);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .in-depth__item {
    display: flex;
  }

  .in-depth__card {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-gap-400);
    padding: var(--space-inset-600);
    color: inherit;
    text-decoration: none;
  }

  .in-depth__more {
    align-self: flex-start;
    margin-top: auto;
  }

  @media (max-width: 1023.98px) {
    .in-depth__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639.98px) {
    .in-depth__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .in-depth__intro {
      padding: var(--space-inset-600);
    }
  }
</style>
