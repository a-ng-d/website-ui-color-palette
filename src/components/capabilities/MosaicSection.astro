---
import type { CapabilityGroup } from '@/data/capabilities'
import FeatureCard from './FeatureCard.astro'

interface Props {
  group: CapabilityGroup
  /** Columns on desktop. */
  columns?: 2 | 3 | 4
  /** Columns from 640 to 1024px. */
  tabletColumns?: 1 | 2
  mediaFirst?: boolean
  /**
   * Platform whose UI the demos wear (`data-platform`); the page imports
   * the matching generated/unoff-tokens-<platform>.css.
   */
  platform?: string
}

const {
  group,
  columns = 3,
  tabletColumns = 2,
  mediaFirst,
  platform,
} = Astro.props
const titleId = `${group.id}-title`
// On two tablet columns, an odd count of single cards leaves the last one
// alone: it takes the whole row.
const singles = group.cards.filter((card) => (card.span ?? 1) === 1).length
const lastAlone = tabletColumns === 2 && singles % 2 === 1
---

<section
  id={group.id}
  class="section mosaic"
  aria-labelledby={titleId}
  data-platform={platform}
  style={`--columns:${columns};--tablet-columns:${tabletColumns}`}
>
  <div class="mosaic__grid">
    <div class="mosaic__intro">
      <h2
        class="t-section-title"
        id={titleId}
      >
        {group.title}
      </h2>
      {group.intro && <p class="t-accent">{group.intro}</p>}
    </div>

    {group.cards.map((card, i) => (
      <FeatureCard
        card={card}
        mediaFirst={mediaFirst}
        class:list={[
          'mosaic__card',
          i === group.cards.length - 1 && lastAlone && 'mosaic__card--fill',
        ]}
      />
    ))}
  </div>
</section>

<style>
  .mosaic__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    grid-auto-rows: minmax(504px, auto);
    gap: var(--space-gap-200);
  }

  .mosaic__intro {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-gap-400);
    transform: rotate(1deg);
    border: var(--stroke-width-thin) solid var(--site-border-soft);
    border-radius: var(--site-radius-card);
    background-color: var(--site-surface);
    padding: var(--space-inset-800);
  }

  .mosaic__grid :global(.mosaic__card) {
    grid-column: span var(--span, 1);
  }

  @media (max-width: 1023.98px) {
    .mosaic__grid {
      grid-template-columns: repeat(var(--tablet-columns), minmax(0, 1fr));
      grid-auto-rows: minmax(440px, auto);
    }

    .mosaic__intro {
      grid-column: 1 / -1;
      transform: none;
    }

    .mosaic__grid :global(.mosaic__card) {
      grid-column: span min(var(--span, 1), var(--tablet-columns));
    }

    .mosaic__grid :global(.mosaic__card--fill) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 639.98px) {
    .mosaic__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
    }

    .mosaic__grid :global(.mosaic__card) {
      grid-column: auto;
    }
  }
</style>
