---
import DemoStage from '../DemoStage.astro'
import CopyIcon from '@lucide/astro/icons/copy'
import Message from '../kit/Message.astro'
import ChoiceChips from './ChoiceChips.astro'
import { tokenFormats } from '@/scripts/demos/tokens'

const formats = tokenFormats()
---

<DemoStage name="tokens">
  <ChoiceChips items={formats} />

  <div
    class="code"
    data-code
    data-active={formats[0].id}
  >
    <span
      class="code__copy"
      data-copy
    >
      <CopyIcon class="k-icon" />
    </span>
    {formats.map((format) => (
      <div
        class="code__lines"
        data-lines={format.id}
      >
        {format.lines.map((line, i) => (
          <code style={`--i:${i}`}>{line}</code>
        ))}
      </div>
    ))}
  </div>
  <Message
    type="success"
    class="toast"
  >
    Copied to clipboard
  </Message>
</DemoStage>

<style>
  .code {
    display: grid;
    position: relative;
    border: var(--stroke-width-thin) solid var(--snippet-border);
    border-radius: var(--radius-large);
    background-color: var(--snippet-background);
    padding: var(--space-inset-300) var(--space-inset-300);
    min-height: 100px;
    overflow: hidden;
    color: var(--snippet-text);
  }

  .code__lines {
    display: flex;
    grid-area: 1 / 1;
    flex-direction: column;
    margin: 0;
    /* The site's snippet look, not the platform's: a fixed size (the Yelbolt
       small text) so the lines fit whatever theme wears the panel (Figma's
       small text is 12px). */
    font-size: var(--font-size-xsmall);
    line-height: var(--text-small-line-height);
    font-family: var(--font-display);
    letter-spacing: 0;
  }

  .code code {
    transition: opacity 200ms var(--easing-standard);
    transition-delay: calc(var(--i) * 60ms);
    font: inherit;
    white-space: pre;
  }

  .code:not([data-active='tailwind']) [data-lines='tailwind'] code,
  .code:not([data-active='dtcg']) [data-lines='dtcg'] code,
  .code:not([data-active='style-dictionary'])
    [data-lines='style-dictionary']
    code {
    opacity: 0;
    transition-delay: 0ms;
  }

  .code__copy {
    display: grid;
    position: absolute;
    top: 6px;
    right: 6px;
    place-items: center;
    z-index: 1;
    cursor: pointer;
    border-radius: var(--radius-medium);
    background-color: var(--snippet-tag-background);
    width: 24px;
    height: 24px;
    color: var(--snippet-text);
  }

  .code__copy :global(.k-icon) {
    color: var(--snippet-text);
  }

  /* Platform pages: the export as the app shows it, in a multiline field,
     with an icon button to copy (Input and IconButton tokens of the theme). */
  :global([data-platform]) .code {
    outline: var(--input-border-width-default) solid
      var(--input-border-color-default);
    outline-offset: var(--input-border-offset-default);
    border: 0;
    border-radius: var(--input-radius);
    background-color: var(--input-background-color-default);
    padding: var(--input-textarea-padding-top)
      var(--input-textarea-padding-right) var(--input-textarea-padding-bottom)
      var(--input-textarea-padding-left);
    color: var(--input-text-color-default);
  }

  /* Colours and radius of the theme's IconButton, compact, beside the short
     closing line (the field's tighter padding lifts the values under the
     top corner). */
  :global([data-platform]) .code__copy {
    top: auto;
    bottom: 6px;
    border-radius: var(--icon-button-base-radius);
    background-color: var(--icon-button-default-background-color-default);
  }

  :global([data-platform]) .code__copy :global(.k-icon) {
    color: var(--icon-button-default-icon-color-default);
  }

  :global(.toast) {
    position: absolute;
    bottom: var(--space-inset-200);
    left: 50%;
    translate: -50% 8px;
    opacity: 0;
    z-index: 3;
    transition:
      opacity var(--motion-duration-base) var(--motion-easing-standard),
      translate var(--motion-duration-base) var(--motion-easing-standard);
    box-shadow: var(--elevation-400-menu-panel);
    white-space: nowrap;
  }

  :global([data-demo-panel]:has([data-copied]) .toast) {
    translate: -50% 0;
    opacity: 1;
  }
</style>
