---
/** Chips acting as a single choice, driven by scripts/demos/choices.ts. A chip without `data-on` takes the inactive tokens. */
interface Props {
  items: ReadonlyArray<{ id: string; label: string }>
  active?: string
}

const { items, active = items[0]?.id } = Astro.props
---

<div class="choices">
  {items.map((item) => (
    <span
      class="k-chip"
      data-choice={item.id}
      data-on={item.id === active ? '' : undefined}
    >
      {item.label}
    </span>
  ))}
</div>

<style>
  .choices {
    --chip-background-color-inactive: transparent;
    --chip-border-color-inactive: var(--k-panel-border);
    --chip-border-width-inactive: var(--stroke-width-thin);
    --chip-text-color-inactive: var(--text-color-secondary);
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-gap-100);
  }

  .choices > :global(.k-chip) {
    cursor: pointer;
  }
</style>
