---
import PostCard from '@/components/blog/PostCard.astro'
import Button from '@/components/ui/Button.astro'
import Tag from '@/components/ui/Tag.astro'
import { getPosts, type Post } from '@/data/blog'

interface Props {
  /** Defaults to the latest articles. */
  posts?: Post[]
  limit?: number
  tag?: string
  title?: string
  /** Date and category on the cards. */
  meta?: boolean
}

const {
  limit = 2,
  tag = 'News',
  title = 'Latest from the UI Color Palette blog',
  meta = false,
} = Astro.props
const posts = (Astro.props.posts ?? (await getPosts())).slice(0, limit)
---

{posts.length > 0 && (
  <section
    class="section posts"
    aria-labelledby="posts-title"
  >
    <div class="posts__layout">
      <div class="posts__intro">
        <Tag size="large">{tag}</Tag>
        <h2
          class="t-section-title"
          id="posts-title"
        >
          {title}
        </h2>
        <Button
          href="/blog"
          variant="secondary"
        >
          See all articles
        </Button>
      </div>

      <ul class="posts__list">
        {posts.map((post) => (
          <li>
            <PostCard
              post={post}
              meta={meta}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .posts__layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-gap-200);
  }

  .posts__intro {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-gap-400);
    transform: rotate(1deg);
    border: var(--stroke-width-thin) solid var(--site-border-soft);
    border-radius: var(--site-radius-card);
    background-color: var(--site-surface);
    padding: var(--space-inset-800);
  }

  .posts__list {
    display: grid;
    gap: var(--space-gap-200);
    padding: 0;
    list-style: none;
  }

  .post {
    display: flex;
    position: relative;
    flex-direction: column;
    --card-radius: var(--space-inset-600);
    height: 400px;
    overflow: clip;
  }

  .post__cover {
    flex: 1 1 auto;
    min-height: 0;
  }

  .post__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-gap-200);
    border-top: var(--stroke-width-thin) solid var(--site-border-strong);
    padding: var(--space-inset-800);
  }

  .post__link {
    text-decoration: none;
  }

  /* The whole card is clickable through the title link. */
  .post__link::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    content: '';
  }

  .post__link:focus-visible {
    outline: none;
  }

  .post__link:focus-visible {
    box-shadow: none;
  }

  .post:has(.post__link:focus-visible) {
    outline: var(--site-focus-outline);
    outline-offset: var(--site-focus-offset);
    box-shadow: var(--site-focus-halo);
  }

  .post__more {
    cursor: pointer;
  }

  .post:hover .post__more {
    --button-base-background-color: var(
      --button-secondary-background-color-hover
    );
    --button-base-border-color: var(--button-secondary-border-color-hover);
  }

  @media (max-width: 1023.98px) {
    .posts__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .posts__intro {
      transform: none;
      min-height: 240px;
    }
  }
</style>
