---
import PostCard from '@/components/blog/PostCard.astro'
import Button from '@/components/ui/Button.astro'
import Tag from '@/components/ui/Tag.astro'
import { getPosts, type Post } from '@/data/blog'

interface Props {
  /** Defaults to the latest articles. */
  posts?: Post[]
  limit?: number
  tag?: string
  title?: string
  /** Date and category on the cards. */
  meta?: boolean
}

const {
  limit = 2,
  tag = 'News',
  title = 'Latest from the UI Color Palette blog',
  meta = false,
} = Astro.props
const posts = (Astro.props.posts ?? (await getPosts())).slice(0, limit)
---

{posts.length > 0 && (
  <section
    class="section posts"
    aria-labelledby="posts-title"
  >
    <div class="posts__layout">
      <div class="posts__intro">
        <Tag size="large">{tag}</Tag>
        <h2
          class="t-section-title"
          id="posts-title"
        >
          {title}
        </h2>
        <Button
          href="/blog"
          variant="secondary"
        >
          See all articles
        </Button>
      </div>

      <ul class="posts__list">
        {posts.map((post) => (
          <li>
            <PostCard
              post={post}
              meta={meta}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .posts__layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-gap-200);
  }

  .posts__intro {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-gap-400);
    transform: rotate(1deg);
    border: var(--stroke-width-thin) solid var(--site-border-soft);
    border-radius: var(--site-radius-card);
    background-color: var(--site-surface);
    padding: var(--space-inset-800);
  }

  .posts__list {
    display: grid;
    gap: var(--space-gap-200);
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1023.98px) {
    .posts__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .posts__intro {
      transform: none;
      min-height: 240px;
    }
  }
</style>
