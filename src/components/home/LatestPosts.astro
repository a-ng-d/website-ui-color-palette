---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'

import Tag from '@/components/ui/Tag.astro'

interface Props {
  limit?: number
}

const { limit = 2 } = Astro.props

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort(
    (a, b) =>
      (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0) ||
      a.id.localeCompare(b.id)
  )
  .slice(0, limit)
---

<section
  class="section posts"
  aria-labelledby="posts-title"
>
  <div class="posts__layout">
    <div class="posts__intro">
      <Tag size="large">News</Tag>
      <h2
        class="t-section-title"
        id="posts-title"
      >
        Here are some exciting updates from our team!
      </h2>
    </div>

    <ul class="posts__list">
      {posts.map((post) => (
        <li>
          <article class="post card">
            <div class="post__cover">
              <Image
                src={post.data.cover}
                alt={post.data.coverAlt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                loading="lazy"
              />
            </div>
            <div class="post__body">
              <h3 class="t-paragraph-secondary-title">
                <a
                  class="post__link"
                  href={`/blog/${post.id}`}
                >
                  {post.data.title}
                </a>
              </h3>
              <p class="post__excerpt">{post.data.description}</p>
              <!-- Looks like a secondary button; the title link makes the whole card clickable. -->
              <span
                class="post__more text-button text-button--secondary text-button--large"
                aria-hidden="true"
              >
                <span class="text-button__label">Read more</span>
              </span>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .posts__layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-gap-200);
  }

  .posts__intro {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-gap-400);
    transform: rotate(1deg);
    border: var(--stroke-width-thin) solid var(--site-border-soft);
    border-radius: var(--site-radius-card);
    background-color: var(--site-surface);
    padding: var(--space-inset-800);
  }

  .posts__list {
    display: grid;
    gap: var(--space-gap-200);
    padding: 0;
    list-style: none;
  }

  .post {
    display: flex;
    position: relative;
    flex-direction: column;
    --card-radius: var(--space-inset-600);
    height: 400px;
    overflow: clip;
  }

  .post__cover {
    flex: 1 1 auto;
    min-height: 0;
  }

  .post__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-gap-200);
    border-top: var(--stroke-width-thin) solid var(--site-border-strong);
    padding: var(--space-inset-800);
  }

  .post__link {
    text-decoration: none;
  }

  /* The whole card is clickable through the title link. */
  .post__link::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    content: '';
  }

  .post__link:focus-visible {
    outline: none;
  }

  .post__link:focus-visible {
    box-shadow: none;
  }

  .post:has(.post__link:focus-visible) {
    outline: var(--site-focus-outline);
    outline-offset: var(--site-focus-offset);
    box-shadow: var(--site-focus-halo);
  }

  .post__more {
    cursor: pointer;
  }

  .post:hover .post__more {
    --button-base-background-color: var(
      --button-secondary-background-color-hover
    );
    --button-base-border-color: var(--button-secondary-border-color-hover);
  }

  @media (max-width: 1023.98px) {
    .posts__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .posts__intro {
      transform: none;
      min-height: 240px;
    }

    .post {
      height: auto;
    }

    .post__cover {
      aspect-ratio: 16 / 9;
    }
  }
</style>
