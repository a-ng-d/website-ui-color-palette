---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PricingHero from '@/components/pricing/PricingHero.astro'
import Plans from '@/components/pricing/Plans.astro'
import Compare from '@/components/pricing/Compare.astro'
import PricingFaq from '@/components/pricing/PricingFaq.astro'
import Reinsurance from '@/components/home/Reinsurance.astro'
import { pricingFaq } from '@/data/faq'
import { faqPage, organization, pricingOffers } from '@/data/structured-data'
---

<BaseLayout
  title="Pricing — UI Color Palette Plans"
  description="Simple, honest pricing for solo makers and teams. Start free on /basic, unlock unlimited color on /pro at $2.99/week, or scale with /ultimate."
  jsonLd={[
    organization(),
    pricingOffers(),
    faqPage(pricingFaq.flatMap((category) => category.items)),
  ]}
>
  <PricingHero />
  <Plans />
  <Compare />
  <PricingFaq categories={pricingFaq} />
  <Reinsurance />
</BaseLayout>
