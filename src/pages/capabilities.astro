---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CapabilitiesHero from '@/components/capabilities/CapabilitiesHero.astro'
import GenerateSection from '@/components/capabilities/GenerateSection.astro'
import MosaicSection from '@/components/capabilities/MosaicSection.astro'
import AudienceSection from '@/components/capabilities/AudienceSection.astro'
import Reinsurance from '@/components/home/Reinsurance.astro'
import NextSteps from '@/components/platform/NextSteps.astro'
import { capabilityPages, capabilityPath } from '@/data/capability-pages'
import {
  capabilityGroups,
  deploy,
  generate,
  master,
  superpowers,
} from '@/data/capabilities'
import {
  organization,
  pageBreadcrumbs,
  softwareApplication,
} from '@/data/structured-data'

const inDepth = [
  ...capabilityPages.map((page) => ({
    icon: 'glasses' as const,
    title: page.name,
    label: 'Explore in depth',
    href: capabilityPath(page),
  })),
  {
    icon: 'book-open' as const,
    title: 'Color glossary',
    label: 'Read the definitions',
    href: '/glossary',
  },
]

const featureList = capabilityGroups.flatMap((group) =>
  group.cards.map((card) => card.title)
)
---

<BaseLayout
  title="Capabilities — Generate, Master & Deploy Color"
  description="Explore everything UI Color Palette can do: AI generation, image extraction, contrast mastering, color modes, and token & Tailwind export."
  jsonLd={[
    organization(),
    { ...softwareApplication(), featureList },
    pageBreadcrumbs('Capabilities', '/capabilities'),
  ]}
>
  <CapabilitiesHero />
  <GenerateSection group={generate} />
  <MosaicSection
    group={master}
    columns={2}
    tabletColumns={1}
  />
  <MosaicSection group={deploy} />
  <MosaicSection
    group={superpowers}
    mediaFirst
  />
  <NextSteps
    steps={inDepth}
    title="Capabilities in depth"
  />
  <AudienceSection />
  <Reinsurance />
</BaseLayout>
